// prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext, pgcrypto]
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  LEAGUE_ADMIN
  PLAYER
}

enum LeagueStatus {
  DRAFT
  ACTIVE
  FINISHED
  ARCHIVED
}

enum TeamCategory {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MatchFormat {
  BEST_OF_3
  BEST_OF_5
  FLEXIBLE
}

// Tipo de la competición. `LEAGUE` es el round-robin clásico que existía antes
// de esta migración (toda fila previa se backfillea a LEAGUE). `AMERICANA` y
// `TOURNAMENT` se construyen sobre el mismo modelo `League` con campos extra.
enum CompetitionType {
  LEAGUE
  AMERICANA
  TOURNAMENT
}

// Variante del formato Americana. Solo aplica si `League.type = AMERICANA`.
//  - ROTATING_INDIVIDUAL: 4–16 jugadores individuales; las parejas cambian
//    cada ronda. La inscripción se hace por usuario (no por Team).
//  - FIXED_PAIRS: parejas inscritas como Team que rotan rivales cada ronda.
enum AmericanaVariant {
  ROTATING_INDIVIDUAL
  FIXED_PAIRS
}

enum AmericanaRoundFormat {
  FIRST_TO_GAMES
  BY_TIME
}

// Bracket de eliminación del torneo. `GOLD` = bracket principal; `SILVER` =
// bracket de consolación poblado con los perdedores de la primera ronda.
enum BracketSide {
  GOLD
  SILVER
}

enum BracketSeeding {
  AUTO
  MANUAL
}

enum MatchStatus {
  SCHEDULED
  DATE_PROPOSED
  DATE_CONFIRMED
  PENDING_VALIDATION
  CONFIRMED
  ADMIN_RESOLVED
  DISPUTED
  EXPIRED_UNPLAYED
  CANCELLED
}

enum MatchResultStatus {
  PENDING
  CONFIRMED
  REJECTED
  SUPERSEDED
}

enum SchedulingProposalStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  COUNTERED
  SUPERSEDED
}

enum ExtensionProposalStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum DisputeResolution {
  AWARD_PROPONENT
  AWARD_OPPONENT
  BOTH_LOST
  EXTEND_DEADLINE
  DISMISS
}

enum CategoryProposalStatus {
  PROPOSED
  ACCEPTED
  REJECTED
}

enum CategoryProposalReason {
  PROMOTION
  DEMOTION
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum IndependentMatchStatus {
  OPEN
  PENDING_APPROVAL
  CONFIRMED
  REJECTED
  CANCELLED
}

enum MatchVisibility {
  PUBLIC
  PRIVATE
}

enum ParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
}

enum NotificationType {
  MATCH_ASSIGNED
  DATE_PROPOSED
  DATE_ACCEPTED
  DATE_REJECTED
  RESULT_SUBMITTED
  RESULT_CONFIRMED
  RESULT_REJECTED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  INDEPENDENT_MATCH_INVITE
  INDEPENDENT_MATCH_JOIN_REQUEST
  INDEPENDENT_MATCH_CONFIRMED
  INDEPENDENT_MATCH_CANCELLED
  LEAGUE_STARTING
  LEAGUE_FINISHED
  DEADLINE_REMINDER
  COMMENTARY_GENERATED
  EXTENSION_PROPOSED
  EXTENSION_ACCEPTED
  EXTENSION_REJECTED
  CATEGORY_CHANGE_PROPOSED
  TEAM_INVITATION
  TEAM_INVITATION_ACCEPTED
  TEAM_INVITATION_REJECTED
  LEAGUE_REGISTRATION_ADDED
  LEAGUE_REGISTRATION_REMOVED
  LEAGUE_REGISTRATION_OPEN
  INDEPENDENT_MATCH_CHAT
  INDEPENDENT_MATCH_DATE_CHANGED
  TEAM_MEMBER_LEFT
  MATCH_PHOTO_UPLOADED
  MATCH_PHOTO_MENTION
  MATCH_PHOTO_COMMENT
}

enum SignedTokenPurpose {
  USER_INVITATION
  EMAIL_VERIFICATION
  PASSWORD_RESET
  RESULT_VALIDATION
  INDEPENDENT_MATCH_INVITE
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum AICommentaryProvider {
  CLAUDE
  OPENAI
}

enum CommentaryType {
  PREVIEW
  RECAP
}

// ─── IDENTIDAD Y AUTH ──────────────────────────────────────────────────────

model User {
  id              String       @id @default(cuid())
  email           String       @unique @db.Citext
  emailVerifiedAt DateTime?    @map("email_verified_at")
  passwordHash    String       @map("password_hash")
  name            String
  avatarUrl       String?      @map("avatar_url")
  phone           String?
  role            UserRole     @default(PLAYER)
  category        TeamCategory @default(INTERMEDIATE) @map("category")

  // 2FA — schema listo, feature OFF hasta Spec 7+
  twoFactorEnabled     Boolean  @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?  @map("two_factor_secret") // cifrado con ENCRYPTION_KEY
  twoFactorBackupCodes String[] @default([]) @map("two_factor_backup_codes")

  // GDPR
  anonymizedAt DateTime? @map("anonymized_at")
  deletedAt    DateTime? @map("deleted_at")

  // Account blocking (e.g. repeated prompt-injection attempts on the
  // chatbot). Strikes counter feeds the auto-block at threshold.
  blockedAt              DateTime? @map("blocked_at")
  blockReason            String?   @map("block_reason")
  promptInjectionStrikes Int       @default(0) @map("prompt_injection_strikes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions                      Session[]
  teamMemberships               TeamMember[]
  auditLogs                     AuditLog[]                    @relation("AuditActor")
  notifications                 Notification[]
  submittedResults              MatchResult[]                 @relation("ResultSubmitter")
  validatedResults              MatchResult[]                 @relation("ResultValidator")
  proposedSchedules             MatchSchedulingProposal[]     @relation("ScheduleProposer")
  respondedSchedules            MatchSchedulingProposal[]     @relation("ScheduleResponder")
  openedDisputes                Dispute[]                     @relation("DisputeOpener")
  resolvedDisputes              Dispute[]                     @relation("DisputeResolver")
  independentMatches            IndependentMatch[]            @relation("IndependentOrganizer")
  indParticipations             IndependentMatchParticipant[]
  indChatMessages               IndependentMatchChatMessage[] @relation("IndMatchChatAuthor")
  matchInvitationsReceived      IndependentMatchInvitation[]
  editedCommentaries            MatchCommentary[]             @relation("CommentaryEditor")
  extensionsProposed            DeadlineExtensionProposal[]   @relation("ExtensionProposer")
  extensionsResponded           DeadlineExtensionProposal[]   @relation("ExtensionResponder")
  resolvedCategoryProposals     TeamCategoryChangeProposal[]  @relation("CategoryProposalResolver")
  teamsCreated                  Team[]                        @relation("TeamCreator")
  teamInvitationsReceived       TeamInvitation[]              @relation("TeamInvitationInvitee")
  teamInvitationsSent           TeamInvitation[]              @relation("TeamInvitationInviter")
  leagueRegistrationsRegistered LeagueRegistration[]          @relation("RegistrationRegisteredBy")
  leagueRegistrationsWithdrawn  LeagueRegistration[]          @relation("RegistrationWithdrawnBy")
  registrationCodesCreated      RegistrationCode[]            @relation("RegistrationCodeCreator")
  registrationCodesUsed         RegistrationCode[]            @relation("RegistrationCodeUser")
  uploadedPhotos                MatchPhoto[]                  @relation("PhotoUploader")
  photoComments                 MatchPhotoComment[]           @relation("PhotoCommentAuthor")
  photoLikes                    MatchPhotoLike[]              @relation("PhotoLikeAuthor")
  pushSubscriptions             PushSubscription[]
  notificationPreference        NotificationPreference?
  registrationsAsIndividual     LeagueRegistration[]          @relation("RegistrationUser")
  matchParticipations           MatchParticipant[]            @relation("MatchParticipantUser")

  @@index([deletedAt, anonymizedAt])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  sessionToken String   @unique @map("session_token")
  expires      DateTime
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SignedToken {
  jti       String             @id
  purpose   SignedTokenPurpose
  subjectId String             @map("subject_id") // userId o matchResultId según purpose
  metadata  Json?
  expiresAt DateTime           @map("expires_at")
  usedAt    DateTime?          @map("used_at")
  createdAt DateTime           @default(now()) @map("created_at")

  @@index([purpose, subjectId])
  @@index([expiresAt])
  @@map("signed_tokens")
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String // formato: "action:scope:identifier"
  count       Int      @default(0)
  windowStart DateTime @map("window_start")

  @@unique([key])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

model RegistrationCode {
  id              String    @id @default(cuid())
  code            String    @unique
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime? @map("expires_at")
  usedAt          DateTime? @map("used_at")
  usedByUserId    String?   @map("used_by_user_id")

  createdBy User  @relation("RegistrationCodeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  usedBy    User? @relation("RegistrationCodeUser", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([usedAt, expiresAt])
  @@map("registration_codes")
}

// ─── LIGAS ────────────────────────────────────────────────────────────────

// El modelo se llama "League" por compatibilidad histórica, pero en la UX
// se presenta como "Competición" desde 2026-05. `type` discrimina entre los
// tres formatos soportados; los campos `americana*` y los campos de torneo
// solo se rellenan cuando el `type` lo requiere.
model League {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  description       String?
  registrationStart DateTime        @map("registration_start")
  registrationEnd   DateTime        @map("registration_end")
  startDate         DateTime        @map("start_date")
  endDate           DateTime        @map("end_date")
  status            LeagueStatus    @default(DRAFT)
  category          TeamCategory    @default(INTERMEDIATE)
  type              CompetitionType @default(LEAGUE)

  // Settings
  matchFormat         MatchFormat @default(FLEXIBLE) @map("match_format")
  defaultDeadlineDays Int         @default(21) @map("default_deadline_days") // 3 semanas
  allowDraws          Boolean     @default(true) @map("allow_draws")
  pointsWin           Int         @default(3) @map("points_win")
  pointsDraw          Int         @default(1) @map("points_draw")
  pointsLoss          Int         @default(0) @map("points_loss")
  tiebreakerConfig    Json        @default("{}") @map("tiebreaker_config")

  // Americana settings (solo aplican si type = AMERICANA)
  americanaVariant      AmericanaVariant?     @map("americana_variant")
  americanaRoundFormat  AmericanaRoundFormat? @map("americana_round_format")
  americanaTargetGames  Int?                  @map("americana_target_games") // FIRST_TO_GAMES, default 8 cuando se use
  americanaRoundMinutes Int?                  @map("americana_round_minutes") // BY_TIME, default 20 cuando se use
  americanaCourts       Int?                  @map("americana_courts") // 1..4

  // Tournament settings (solo aplican si type = TOURNAMENT)
  hasGroupPhase      Boolean         @default(false) @map("has_group_phase")
  groupCount         Int?            @map("group_count")
  teamsPerGroup      Int?            @map("teams_per_group")
  qualifiersPerGroup Int?            @map("qualifiers_per_group")
  bracketSeedingMode BracketSeeding? @map("bracket_seeding_mode") // null hasta que se cree el bracket

  createdByUserId            String    @map("created_by_user_id")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  finalizedAt                DateTime? @map("finalized_at")
  registrationOpenNotifiedAt DateTime? @map("registration_open_notified_at")

  registrations      LeagueRegistration[]
  matches            Match[]
  groups             CompetitionGroup[]
  independentMatches IndependentMatch[]           @relation("IndependentMatchLeague")
  categoryProposals  TeamCategoryChangeProposal[]

  @@index([status])
  @@index([startDate, endDate])
  @@index([type, status])
  @@map("leagues")
}

model Team {
  id              String       @id @default(cuid())
  name            String
  category        TeamCategory @default(INTERMEDIATE)
  logoUrl         String?      @map("logo_url")
  createdByUserId String       @map("created_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  createdBy            User                         @relation("TeamCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members              TeamMember[]
  invitations          TeamInvitation[]
  registrations        LeagueRegistration[]
  homeMatches          Match[]                      @relation("TeamA")
  awayMatches          Match[]                      @relation("TeamB")
  wonMatches           MatchResult[]                @relation("MatchWinner")
  submittedResults     MatchResult[]                @relation("MatchResultSubmitterTeam")
  hostedMatches        IndependentMatch[]           @relation("MatchHostTeam")
  matchTeamInvitations IndependentMatchInvitation[] @relation("MatchTeamInvitations")
  categoryProposals    TeamCategoryChangeProposal[]

  @@unique([createdByUserId, name])
  @@map("teams")
}

model TeamInvitation {
  id              String               @id @default(cuid())
  teamId          String               @map("team_id")
  invitedUserId   String               @map("invited_user_id")
  invitedByUserId String               @map("invited_by_user_id")
  status          TeamInvitationStatus @default(PENDING)
  createdAt       DateTime             @default(now()) @map("created_at")
  resolvedAt      DateTime?            @map("resolved_at")

  team        Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedUser User @relation("TeamInvitationInvitee", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User @relation("TeamInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([invitedUserId, status])
  @@index([teamId, status])
  @@map("team_invitations")
}

// Inscripción a una Competición. En LEAGUE / TOURNAMENT / AMERICANA-FIXED_PAIRS
// la inscripción es por pareja (Team). El campo `userId` queda reservado para
// Americana ROTATING_INDIVIDUAL — se cableará en sub-fase 4 cuando se haga
// `teamId` nullable; ahora mismo el schema mantiene `teamId` obligatorio para
// no romper el código existente.
model LeagueRegistration {
  id                 String    @id @default(cuid())
  leagueId           String    @map("league_id")
  // teamId nullable a partir de Competitions v2 para soportar Americana
  // ROTATING_INDIVIDUAL: la inscripción es por usuario (userId set, teamId null).
  // Para el resto de tipos teamId sigue siendo siempre obligatorio — validado
  // a nivel de `LeagueRegistrationService.register`.
  teamId             String?   @map("team_id")
  userId             String?   @map("user_id")
  competitionGroupId String?   @map("competition_group_id")
  registeredByUserId String    @map("registered_by_user_id")
  registeredAt       DateTime  @default(now()) @map("registered_at")
  withdrawnAt        DateTime? @map("withdrawn_at")
  withdrawnByUserId  String?   @map("withdrawn_by_user_id")

  league       League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  team         Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User?             @relation("RegistrationUser", fields: [userId], references: [id], onDelete: Cascade)
  group        CompetitionGroup? @relation(fields: [competitionGroupId], references: [id], onDelete: SetNull)
  registeredBy User              @relation("RegistrationRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: Restrict)
  withdrawnBy  User?             @relation("RegistrationWithdrawnBy", fields: [withdrawnByUserId], references: [id], onDelete: SetNull)

  @@unique([leagueId, teamId])
  // Postgres trata múltiples NULL como distintos en UNIQUE; este constraint
  // no afecta a filas con userId NULL.
  @@unique([leagueId, userId])
  @@index([leagueId])
  @@index([teamId])
  @@index([userId])
  @@index([competitionGroupId])
  @@map("league_registrations")
}

// Grupo dentro de una competición de tipo TOURNAMENT con fase de grupos.
// Cada `LeagueRegistration` queda asignada a UN `CompetitionGroup` cuando se
// activa el torneo; los `Match` de fase de grupos referencian su grupo.
model CompetitionGroup {
  id        String   @id @default(cuid())
  leagueId  String   @map("league_id")
  name      String // "Grupo A", "Grupo B"...
  index     Int // 0..N para ordenar
  createdAt DateTime @default(now()) @map("created_at")

  league        League               @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  registrations LeagueRegistration[]
  matches       Match[]

  @@unique([leagueId, index])
  @@index([leagueId])
  @@map("competition_groups")
}

// Participación en un Match de Americana ROTATING_INDIVIDUAL: enumera los 4
// jugadores del match con su side (A/B) y su partner index. No se usa para
// el resto de formatos (Liga / Torneo / Americana FIXED_PAIRS) donde teamA/B
// del Match identifican ya a los dos pares.
model MatchParticipant {
  matchId      String @map("match_id")
  userId       String @map("user_id")
  side         String // "A" o "B"
  partnerIndex Int    @map("partner_index") // 1 o 2 dentro del side

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation("MatchParticipantUser", fields: [userId], references: [id], onDelete: Restrict)

  @@id([matchId, userId])
  @@unique([matchId, side, partnerIndex])
  @@index([userId])
  @@map("match_participants")
}

model TeamCategoryChangeProposal {
  id               String                 @id @default(cuid())
  teamId           String                 @map("team_id")
  leagueId         String                 @map("league_id")
  fromCategory     TeamCategory           @map("from_category")
  toCategory       TeamCategory           @map("to_category")
  reason           CategoryProposalReason
  status           CategoryProposalStatus @default(PROPOSED)
  resolvedByUserId String?                @map("resolved_by_user_id")
  resolvedAt       DateTime?              @map("resolved_at")
  createdAt        DateTime               @default(now()) @map("created_at")

  team           Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  league         League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  resolvedByUser User?  @relation("CategoryProposalResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([leagueId])
  @@map("team_category_change_proposals")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// ─── PARTIDOS ────────────────────────────────────────────────────────────

model Match {
  id       String      @id @default(cuid())
  leagueId String      @map("league_id")
  // Nullables a partir de Competitions v2: en Americana ROTATING_INDIVIDUAL los
  // 4 jugadores viven en `MatchParticipant` y no hay Team. En el primer round
  // del bracket de Torneo con byes también pueden ser null hasta que se
  // resuelve el match fuente. Para Liga, Torneo (post-asignación) y Americana
  // FIXED_PAIRS siguen estando siempre presentes — el helper
  // `assertTwoTeamMatch` se usa en los call-sites que necesitan asumirlo.
  teamAId  String?     @map("team_a_id")
  teamBId  String?     @map("team_b_id")
  status   MatchStatus @default(SCHEDULED)

  scheduledAt DateTime? @map("scheduled_at") // fecha acordada
  deadlineAt  DateTime  @map("deadline_at") // blando; se endurece al endDate de liga

  confirmedResultId String? @unique @map("confirmed_result_id")
  winnerTeamId      String? @map("winner_team_id") // null si empate
  isTiebreaker      Boolean @default(false) @map("is_tiebreaker")
  round             Int?

  // Americana — solo si la liga es type=AMERICANA. round/court identifican
  // posición en la grilla de rondas × pistas paralelas.
  americanaRound Int? @map("americana_round")
  americanaCourt Int? @map("americana_court")

  // Tournament — solo si la liga es type=TOURNAMENT. Un match es de fase de
  // grupos (competitionGroupId set, bracket* null) o de bracket (bracketSide
  // + bracketRound + bracketPosition set, competitionGroupId null). sourceMatchA/B
  // referencian los matches cuyos ganadores se cruzan aquí — null en la
  // primera ronda del bracket o cuando es bye.
  competitionGroupId String?      @map("competition_group_id")
  bracketSide        BracketSide? @map("bracket_side")
  bracketRound       Int?         @map("bracket_round") // 0 = primera ronda, 1 = cuartos, etc.
  bracketPosition    Int?         @map("bracket_position") // slot dentro de la ronda
  sourceMatchAId     String?      @map("source_match_a_id")
  sourceMatchBId     String?      @map("source_match_b_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  league              League                      @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  teamA               Team?                       @relation("TeamA", fields: [teamAId], references: [id], onDelete: Restrict)
  teamB               Team?                       @relation("TeamB", fields: [teamBId], references: [id], onDelete: Restrict)
  competitionGroup    CompetitionGroup?           @relation(fields: [competitionGroupId], references: [id], onDelete: SetNull)
  sourceMatchA        Match?                      @relation("BracketSourceA", fields: [sourceMatchAId], references: [id], onDelete: SetNull)
  sourceMatchB        Match?                      @relation("BracketSourceB", fields: [sourceMatchBId], references: [id], onDelete: SetNull)
  bracketChildrenA    Match[]                     @relation("BracketSourceA")
  bracketChildrenB    Match[]                     @relation("BracketSourceB")
  confirmedResult     MatchResult?                @relation("ConfirmedResult", fields: [confirmedResultId], references: [id])
  results             MatchResult[]               @relation("MatchResults")
  schedulingProposals MatchSchedulingProposal[]
  extensionProposals  DeadlineExtensionProposal[]
  dispute             Dispute?
  commentaries        MatchCommentary[]
  photos              MatchPhoto[]
  participants        MatchParticipant[]

  @@index([leagueId, status])
  @@index([deadlineAt])
  @@index([teamAId])
  @@index([teamBId])
  @@index([competitionGroupId])
  @@index([leagueId, bracketSide, bracketRound])
  @@map("matches")
}

model MatchResult {
  id                String            @id @default(cuid())
  matchId           String            @map("match_id")
  submittedByUserId String            @map("submitted_by_user_id")
  // Snapshot of the submitter's team at submit time. Decouples the
  // canValidate / confirm / dispute logic from the live team roster, so a
  // submitter who later leaves their team cannot deadlock validation.
  // Nullable only because legacy rows pre-dating this column may resolve
  // by falling back to the live-roster derivation in `getSubmitterSide`.
  submitterTeamId   String?           @map("submitter_team_id")
  submittedAt       DateTime          @default(now()) @map("submitted_at")
  status            MatchResultStatus @default(PENDING)
  winnerTeamId      String?           @map("winner_team_id") // null = empate; calculado al submit
  validatedByUserId String?           @map("validated_by_user_id")
  validatedAt       DateTime?         @map("validated_at")
  autoApprovedAt    DateTime?         @map("auto_approved_at")
  rejectionReason   String?           @map("rejection_reason")
  rejectedAt        DateTime?         @map("rejected_at")

  match            Match  @relation("MatchResults", fields: [matchId], references: [id], onDelete: Cascade)
  submitter        User   @relation("ResultSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  validator        User?  @relation("ResultValidator", fields: [validatedByUserId], references: [id], onDelete: Restrict)
  winnerTeam       Team?  @relation("MatchWinner", fields: [winnerTeamId], references: [id], onDelete: Restrict)
  submitterTeam    Team?  @relation("MatchResultSubmitterTeam", fields: [submitterTeamId], references: [id], onDelete: SetNull)
  sets             Set[]
  matchAsConfirmed Match? @relation("ConfirmedResult")

  @@index([matchId, status])
  @@index([submittedByUserId])
  @@map("match_results")
}

model Set {
  id            String @id @default(cuid())
  matchResultId String @map("match_result_id")
  setNumber     Int    @map("set_number") // 1..5
  gamesA        Int    @map("games_a")
  gamesB        Int    @map("games_b")

  matchResult MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)

  @@unique([matchResultId, setNumber])
  @@map("sets")
}

model MatchSchedulingProposal {
  id                String                   @id @default(cuid())
  matchId           String                   @map("match_id")
  proposedByUserId  String                   @map("proposed_by_user_id")
  proposedDate      DateTime                 @map("proposed_date")
  status            SchedulingProposalStatus @default(PROPOSED)
  respondedByUserId String?                  @map("responded_by_user_id")
  respondedAt       DateTime?                @map("responded_at")
  rejectionReason   String?                  @map("rejection_reason")
  createdAt         DateTime                 @default(now()) @map("created_at")

  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  proposer  User  @relation("ScheduleProposer", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  responder User? @relation("ScheduleResponder", fields: [respondedByUserId], references: [id], onDelete: Restrict)

  @@index([matchId, status])
  @@map("match_scheduling_proposals")
}

model DeadlineExtensionProposal {
  id                 String                  @id @default(cuid())
  matchId            String                  @map("match_id")
  proposedByUserId   String                  @map("proposed_by_user_id")
  proposedDeadlineAt DateTime                @map("proposed_deadline_at")
  status             ExtensionProposalStatus @default(PROPOSED)
  respondedByUserId  String?                 @map("responded_by_user_id")
  respondedAt        DateTime?               @map("responded_at")
  createdAt          DateTime                @default(now()) @map("created_at")

  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  proposer  User  @relation("ExtensionProposer", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  responder User? @relation("ExtensionResponder", fields: [respondedByUserId], references: [id], onDelete: Restrict)

  @@index([matchId, status])
  @@map("deadline_extension_proposals")
}

model Dispute {
  id               String             @id @default(cuid())
  matchId          String             @unique @map("match_id")
  openedByUserId   String             @map("opened_by_user_id")
  reason           String
  evidenceSnapshot Json               @map("evidence_snapshot") // histórico serializado al abrir
  status           DisputeStatus      @default(OPEN)
  resolution       DisputeResolution?
  adminNote        String?            @map("admin_note")
  newDeadlineAt    DateTime?          @map("new_deadline_at")
  resolvedByUserId String?            @map("resolved_by_user_id")
  resolvedAt       DateTime?          @map("resolved_at")
  createdAt        DateTime           @default(now()) @map("created_at")

  match    Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  opener   User  @relation("DisputeOpener", fields: [openedByUserId], references: [id], onDelete: Restrict)
  resolver User? @relation("DisputeResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("disputes")
}

model MatchCommentary {
  id                String               @id @default(cuid())
  matchId           String               @map("match_id")
  type              CommentaryType
  provider          AICommentaryProvider
  content           String
  generatedAt       DateTime             @default(now()) @map("generated_at")
  regeneratedCount  Int                  @default(0) @map("regenerated_count")
  rejectedForSafety Boolean              @default(false) @map("rejected_for_safety")
  promptVersion     String               @default("v1") @map("prompt_version")
  editedAt          DateTime?            @map("edited_at")
  editedByUserId    String?              @map("edited_by_user_id")

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  editor User? @relation("CommentaryEditor", fields: [editedByUserId], references: [id], onDelete: Restrict)

  @@unique([matchId, type])
  @@map("match_commentaries")
}

// ─── PARTIDOS INDEPENDIENTES ─────────────────────────────────────────────

model IndependentMatch {
  id          String                 @id @default(cuid())
  organizerId String                 @map("organizer_id")
  name        String
  visibility  MatchVisibility        @default(PUBLIC) @map("visibility")
  hostTeamId  String?                @map("host_team_id")
  leagueId    String?                @map("league_id")
  scheduledAt DateTime?              @map("scheduled_at")
  location    String?
  description String?
  maxPlayers  Int                    @default(4) @map("max_players")
  status      IndependentMatchStatus @default(OPEN)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  organizer    User                          @relation("IndependentOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  hostTeam     Team?                         @relation("MatchHostTeam", fields: [hostTeamId], references: [id], onDelete: SetNull)
  league       League?                       @relation("IndependentMatchLeague", fields: [leagueId], references: [id], onDelete: Restrict)
  participants IndependentMatchParticipant[]
  invitations  IndependentMatchInvitation[]
  chatMessages IndependentMatchChatMessage[]
  photos       MatchPhoto[]

  @@index([status, scheduledAt])
  @@map("independent_matches")
}

model IndependentMatchChatMessage {
  id        String   @id @default(cuid())
  matchId   String   @map("match_id")
  userId    String   @map("user_id")
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at")

  match IndependentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User             @relation("IndMatchChatAuthor", fields: [userId], references: [id], onDelete: Restrict)

  @@index([matchId, createdAt])
  @@map("independent_match_chat_messages")
}

model IndependentMatchParticipant {
  id                 String            @id @default(cuid())
  independentMatchId String            @map("independent_match_id")
  userId             String            @map("user_id")
  status             ParticipantStatus @default(INVITED)
  respondedAt        DateTime?         @map("responded_at")

  match IndependentMatch @relation(fields: [independentMatchId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([independentMatchId, userId])
  @@map("independent_match_participants")
}

model IndependentMatchInvitation {
  id            String    @id @default(cuid())
  matchId       String    @map("match_id")
  email         String?   @db.Citext
  invitedUserId String?   @map("invited_user_id")
  invitedTeamId String?   @map("invited_team_id")
  expiresAt     DateTime  @map("expires_at")
  acceptedAt    DateTime? @map("accepted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  match       IndependentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  invitedUser User?            @relation(fields: [invitedUserId], references: [id], onDelete: SetNull)
  invitedTeam Team?            @relation("MatchTeamInvitations", fields: [invitedTeamId], references: [id], onDelete: Cascade)

  @@unique([matchId, email], map: "imi_match_email_uniq")
  @@unique([matchId, invitedUserId], map: "imi_match_user_uniq")
  @@unique([matchId, invitedTeamId], map: "imi_match_team_uniq")
  @@index([matchId])
  @@map("independent_match_invitations")
}

// ─── FOTOS POSTPARTIDO ───────────────────────────────────────────────────
// Una sola tabla cubre fotos de partidos de liga (Match) y partidos sueltos
// (IndependentMatch). Exactamente uno de los dos foreign keys está poblado.

model MatchPhoto {
  id                 String   @id @default(cuid())
  matchId            String?  @map("match_id")
  independentMatchId String?  @map("independent_match_id")
  uploadedByUserId   String   @map("uploaded_by_user_id")
  blobUrl            String   @map("blob_url")
  width              Int?
  height             Int?
  createdAt          DateTime @default(now()) @map("created_at")

  match            Match?              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  independentMatch IndependentMatch?   @relation(fields: [independentMatchId], references: [id], onDelete: Cascade)
  uploader         User                @relation("PhotoUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  comments         MatchPhotoComment[]
  likes            MatchPhotoLike[]

  @@index([matchId, createdAt])
  @@index([independentMatchId, createdAt])
  @@map("match_photos")
}

model MatchPhotoComment {
  id        String   @id @default(cuid())
  photoId   String   @map("photo_id")
  userId    String   @map("user_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  photo MatchPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User       @relation("PhotoCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([photoId, createdAt])
  @@map("match_photo_comments")
}

model MatchPhotoLike {
  photoId   String   @map("photo_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  photo MatchPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User       @relation("PhotoLikeAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@id([photoId, userId])
  @@index([photoId])
  @@map("match_photo_likes")
}

// ─── INFRA COMÚN ─────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?        @map("read_at")
  // Outbox marker for the web-push fan-out: heartbeat sweeps fresh rows where
  // this is NULL and enqueues `send-push` jobs, then stamps it. Old rows
  // (createdAt < 5min ago at sweep time) are skipped to avoid backfilling.
  pushDispatchedAt DateTime?  @map("push_dispatched_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([pushDispatchedAt, createdAt])
  @@map("notifications")
}

// Web Push (RFC 8030) subscription. One row per browser/device per user.
// `endpoint` is globally unique because the same physical device can host
// only one push registration at a time per origin; if a different user logs
// in and re-subscribes from the same browser the upsert reassigns `userId`.
model PushSubscription {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  lastErrorAt DateTime? @map("last_error_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Per-user push channel preferences. In-app notifications are not gated by
// this table (they are always created); only the push fan-out checks it.
// Row is upserted with defaults the first time the user opts in.
model NotificationPreference {
  userId           String   @id @map("user_id")
  pushInvitations  Boolean  @default(true)  @map("push_invitations")
  pushMatchDates   Boolean  @default(true)  @map("push_match_dates")
  pushResults      Boolean  @default(true)  @map("push_results")
  pushPhotos       Boolean  @default(true)  @map("push_photos")
  pushChat         Boolean  @default(false) @map("push_chat")
  pushLeagueEvents Boolean  @default(true)  @map("push_league_events")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model EmailLog {
  id                String      @id @default(cuid())
  toEmail           String      @map("to_email")
  template          String
  subject           String
  providerMessageId String?     @map("provider_message_id")
  status            EmailStatus @default(QUEUED)
  attempt           Int         @default(1)
  errorMessage      String?     @map("error_message")
  dedupKey          String?     @unique @map("dedup_key")
  createdAt         DateTime    @default(now()) @map("created_at")
  sentAt            DateTime?   @map("sent_at")

  @@index([status])
  @@index([toEmail])
  @@map("email_logs")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id") // null si sistema
  action     String // p. ej., "match.result.confirmed"
  targetType String   @map("target_type") // p. ej., "Match"
  targetId   String   @map("target_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model JobDeadLetter {
  id       String   @id @default(cuid())
  jobName  String   @map("job_name")
  jobId    String   @map("job_id") // id de pg-boss
  payload  Json
  error    String
  failedAt DateTime @default(now()) @map("failed_at")

  @@index([jobName, failedAt])
  @@map("job_dead_letters")
}
